   120	    private func proxyConnection() -> NSXPCConnection {
   121	        if let connection { return connection }
   122	        let c = NSXPCConnection(machServiceName: HelperConstants.machServiceName, options: .privileged)
   123	        c.remoteObjectInterface = NSXPCInterface(with: HelperProtocol.self)
   124	        c.setCodeSigningRequirement(HelperConstants.helperRequirement)
   125	        c.invalidationHandler = { [weak self] in
   126	            Task { @MainActor in self?.connection = nil }
   127	        }
   128	        c.interruptionHandler = { [weak self] in
   129	            Task { @MainActor in self?.connection = nil }
   130	        }
   131	        c.resume()
   132	        connection = c
   133	        return c
   134	    }
