     4	/// Cleanup targets that need root. Paths and commands are fixed here; the app only
     5	/// ever sends target IDs.
     6	enum RootTargets {
     7	    static let libraryCachesID = "root.library-caches"
     8	    static let unifiedLogsID = "root.unified-logs"
     9	    static let snapshotPrefix = "root.tm-snapshot."
    10	
    11	    static func list() -> [CleanupTarget] {
    12	        var targets: [CleanupTarget] = []
    13	
    14	        let caches = SafeDeleter.measureContents(of: "/Library/Caches")
    15	        targets.append(CleanupTarget(
    16	            id: libraryCachesID, group: "System caches",
    17	            title: "System-wide caches (/Library/Caches)",
    18	            detail: "Caches shared by all users. Apps and macOS rebuild them as needed.",
    19	            executor: .root, defaultSelected: true, irreversible: true,
    20	            estimatedBytes: caches.bytes, preview: caches.preview, command: nil))
    21	
    22	        let logBytes = SafeDeleter.measureContents(of: "/private/var/db/diagnostics").bytes
    23	            &+ SafeDeleter.measureContents(of: "/private/var/db/uuidtext").bytes
    24	        targets.append(CleanupTarget(
    25	            id: unifiedLogsID, group: "System logs",
    26	            title: "Unified log history",
    27	            detail: "Erases all macOS diagnostic log history, including what Apple Support and crash diagnosis rely on. The space comes back slowly as new logs are written.",
    28	            executor: .root, defaultSelected: false, irreversible: true,
    29	            estimatedBytes: logBytes, preview: ["/private/var/db/diagnostics", "/private/var/db/uuidtext"],
    30	            command: "/usr/bin/log erase --all"))
    31	
    32	        for date in localSnapshotDates() {
    33	            targets.append(CleanupTarget(
    34	                id: snapshotPrefix + date, group: "Time Machine local snapshots",
    35	                title: "Local snapshot \(date)",
    36	                detail: "A Time Machine snapshot kept on this disk. macOS deletes these on its own when space runs low or after 24 hours. Its size cannot be measured until it is gone.",
    37	                executor: .root, defaultSelected: false, irreversible: true,
    38	                estimatedBytes: nil, preview: [],
    39	                command: "/usr/bin/tmutil deletelocalsnapshots \(date)"))
    40	        }
    41	        return targets
    42	    }
    43	
    44	    static func run(id: String) -> CleanupTargetResult {
    45	        var result = CleanupTargetResult(targetID: id, freedBytes: 0, removed: 0, failed: 0, failures: [], output: nil)
    46	        switch id {
    47	        case libraryCachesID:
    48	            let r = SafeDeleter.removeContents(of: "/Library/Caches")
    49	            result.removed = r.removed
    50	            result.freedBytes = r.freedBytes
    51	            result.failed = r.failures.count
    52	            result.failures = r.failures.prefix(50).map { CleanupItemResult(path: $0.path, ok: false, message: $0.reason) }
    53	        case unifiedLogsID:
    54	            let out = Command.run("/usr/bin/log", ["erase", "--all"], timeout: 120)
    55	            result.output = out.output
    56	            if out.status != 0 { result.failed = 1 } else { result.removed = 1 }
    57	        case let s where s.hasPrefix(snapshotPrefix):
    58	            let date = String(s.dropFirst(snapshotPrefix.count))
    59	            guard isSnapshotDate(date) else { result.failed = 1; result.output = "Invalid snapshot date."; break }
    60	            let out = Command.run("/usr/bin/tmutil", ["deletelocalsnapshots", date], timeout: 300)
    61	            result.output = out.output
    62	            if out.status != 0 { result.failed = 1 } else { result.removed = 1 }
    63	        default:
    64	            result.failed = 1
    65	            result.output = "Unknown target."
    66	        }
    67	        return result
    68	    }
