   202	    func rootTargets() async throws -> [CleanupTarget] {
   203	        guard isReady else { return [] }
   204	        let data: Data = try await call { proxy, done in proxy.rootCleanupTargets { done(.success($0)) } }
   205	        guard let targets = try? JSONDecoder().decode([CleanupTarget].self, from: data) else { throw HelperError.badReply }
   206	        return targets
   207	    }
