   249	    // MARK: - Running
   250	
   251	    static func run(id: String) -> CleanupTargetResult {
   252	        var result = CleanupTargetResult(targetID: id, freedBytes: 0, removed: 0, failed: 0, failures: [], output: nil)
   253	        if let cmd = commandSpec(for: id) {
   254	            let out = Command.run(cmd.path, cmd.args, environment: toolEnvironment, timeout: cmd.timeout)
   255	            result.output = "$ \(cmd.display)\n" + out.output
   256	            if out.status == 0 { result.removed = 1 } else { result.failed = 1 }
   257	            return result
   258	        }
   259	        let specs = dirSpecs(for: id)
   260	        guard !specs.isEmpty else {
   261	            result.failed = 1
   262	            result.output = "Unknown target."
   263	            return result
   264	        }
   265	        for s in specs {
   266	            let r = SafeDeleter.removeContents(of: s.path, onlyTopLevel: s.only, keepTopLevel: s.keep, requiredOwner: getuid())
   267	            result.removed += r.removed
   268	            result.freedBytes &+= r.freedBytes
   269	            result.failed += r.failures.count
   270	            result.failures += r.failures.prefix(50).map { CleanupItemResult(path: $0.path, ok: false, message: $0.reason) }
   271	        }
   272	        return result
   273	    }
