   193	            guard let chunk else { throw HelperError.badReply }
   194	            blob.append(chunk)
   195	            total = count
   196	            index += 1
   197	        }
   198	        let tree = try await Task.detached(priority: .userInitiated) { try FlatTree.decode(blob) }.value
   199	        return tree
   200	    }
