    12	@MainActor
    13	@Observable
    14	final class AppModel {
    15	    let helper = HelperClient()
    16	
    17	    var volumes: VolumeReport?
    18	    var data: ScannedTree?
    19	    var system: ScannedTree?
    20	    var preboot: ScannedTree?
    21	    var index: CategoryIndex?
    22	
    23	    var isScanning = false
    24	    var scanMessage = ""
    25	    var scanError: String?
    26	    var hasFullDiskAccess = true
    27	
    28	    @ObservationIgnored private var scanTask: Task<Void, Never>?
    29	
    30	    /// The user's home as a path on the Data volume, e.g. "/Users/sandy".
    31	    nonisolated static var homeRelative: String { NSHomeDirectory() }
    32	    static let dataRoot = "/System/Volumes/Data"
    33	
    34	    func start() async {
    35	        await helper.refresh()
    36	        hasFullDiskAccess = AppModel.checkFullDiskAccess()
    37	        if volumes == nil { volumes = await Task.detached { VolumeReport.load() }.value }
    38	    }
    39	
    40	    /// TCC-protected folders that only open with Full Disk Access.
    41	    nonisolated static func checkFullDiskAccess() -> Bool {
    42	        let probes = ["/Library/Application Support/com.apple.TCC/TCC.db",
    43	                      NSHomeDirectory() + "/Library/Safari/Bookmarks.plist"]
    44	        for p in probes where FileManager.default.fileExists(atPath: p) {
    45	            if FileManager.default.isReadableFile(atPath: p), (try? Data(contentsOf: URL(fileURLWithPath: p), options: .mappedIfSafe)) != nil {
    46	                return true
    47	            }
    48	            return false
    49	        }
    50	        return true
    51	    }
    52	
    53	    func scanAll() {
    54	        guard !isScanning else { return }
    55	        scanTask = Task { await runScan() }
    56	    }
    57	
    58	    func cancelScan() {
    59	        scanTask?.cancel()
    60	    }
    61	
    62	    private func runScan() async {
    63	        isScanning = true
    64	        scanError = nil
    65	        defer { isScanning = false; scanMessage = "" }
    66	
    67	        scanMessage = "Reading volumes…"
    68	        volumes = await Task.detached { VolumeReport.load() }.value
    69	        hasFullDiskAccess = AppModel.checkFullDiskAccess()
    70	
    71	        do {
    72	            // Sealed system volume: world-readable, scanned by the app itself.
    73	            scanMessage = "Scanning the macOS system volume…"
    74	            let sys = try await localScan(root: "/", label: "macOS system volume")
    75	            system = ScannedTree(tree: sys, source: .user, date: Date())
    76	
    77	            // Data volume: root helper if available, otherwise this user's view.
    78	            let dataTree: FlatTree
    79	            let source: ScannedTree.Source
    80	            if helper.isReady {
    81	                dataTree = try await helper.scan(root: AppModel.dataRoot) { [weak self] s in
    82	                    self?.scanMessage = "Scanning the Data volume as root… \(s.itemsVisited.formatted()) items, \(ByteFormat.string(s.bytesSeen))"
    83	                }
    84	                source = .helper
    85	            } else {
    86	                dataTree = try await localScan(root: AppModel.dataRoot, label: "Data volume (limited)")
    87	                source = .user
    88	            }
    89	            scanMessage = "Sorting into categories…"
    90	            let rules = RuleSet.bundled(homeRelative: AppModel.homeRelative)
    91	            let idx = await Task.detached(priority: .userInitiated) { CategoryIndex(tree: dataTree, rules: rules) }.value
    92	            data = ScannedTree(tree: dataTree, source: source, date: Date())
    93	            index = idx
    94	
    95	            if helper.isReady {
    96	                let pre = try await helper.scan(root: "/System/Volumes/Preboot") { [weak self] s in
    97	                    self?.scanMessage = "Scanning Preboot… \(s.itemsVisited.formatted()) items"
    98	                }
    99	                preboot = ScannedTree(tree: pre, source: .helper, date: Date())
   100	            }
   101	        } catch is CancellationError {
   102	            scanError = "Scan cancelled."
   103	        } catch {
   104	            scanError = error.localizedDescription
   105	        }
   106	    }
   107	
   108	    private func localScan(root: String, label: String) async throws -> FlatTree {
   109	        let scanner = BulkScanner(rootPath: root)
   110	        let poll = Task { @MainActor [weak self] in
   111	            while !Task.isCancelled {
   112	                try? await Task.sleep(for: .milliseconds(400))
   113	                let p = scanner.progress
   114	                self?.scanMessage = "Scanning \(label)… \(p.itemsVisited.formatted()) items, \(ByteFormat.string(p.bytesSeen))"
   115	            }
   116	        }
   117	        defer { poll.cancel() }
   118	        return try await withTaskCancellationHandler {
   119	            try await Task.detached(priority: .userInitiated) { try scanner.scan() }.value
   120	        } onCancel: {
   121	            scanner.cancel()
   122	        }
   123	    }
