    82	/// Result of matching rules against a Data-volume tree.
    83	struct Classification {
    84	    /// `StorageCategory.index` for every node.
    85	    var categoryOf: [UInt8]
    86	    /// Index into `RuleSet.rules` for nodes a rule names exactly, else -1.
    87	    var ruleOf: [Int32]
    88	}
    89	
    90	/// Path rules compiled into a trie of path segments.
    91	final class RuleSet {
    92	    let rules: [Rule]
    93	    private struct TrieNode {
    94	        var literal: [String: Int] = [:]
    95	        var globs: [(String, Int)] = []
    96	        var rule: Int?
    97	    }
    98	    private var trie: [TrieNode] = [TrieNode()]
    99	
   100	    /// - Parameter homeRelative: the user's home as a path on the Data volume, e.g. "/Users/sandy".
   101	    init(rules: [Rule], homeRelative: String) {
   102	        self.rules = rules
   103	        for (i, rule) in rules.enumerated() {
   104	            var path = rule.path
   105	            if path == "~" { path = homeRelative } else if path.hasPrefix("~/") { path = homeRelative + path.dropFirst() }
   106	            var node = 0
   107	            for seg in path.split(separator: "/").map(String.init) {
   108	                let isGlob = seg.contains("*") || seg.contains("?") || seg.contains("[")
   109	                if isGlob {
   110	                    if let existing = trie[node].globs.first(where: { $0.0 == seg }) {
   111	                        node = existing.1
   112	                    } else {
   113	                        trie.append(TrieNode())
   114	                        trie[node].globs.append((seg, trie.count - 1))
   115	                        node = trie.count - 1
   116	                    }
   117	                } else if let next = trie[node].literal[seg] {
   118	                    node = next
   119	                } else {
   120	                    trie.append(TrieNode())
   121	                    trie[node].literal[seg] = trie.count - 1
   122	                    node = trie.count - 1
   123	                }
   124	            }
   125	            trie[node].rule = i // later rules overwrite earlier ones for the same path
   126	        }
   127	    }
   128	
   129	    static func bundled(homeRelative: String) -> RuleSet {
   130	        guard let url = Bundle.main.url(forResource: "rules", withExtension: "json"),
   131	              let data = try? Data(contentsOf: url),
   132	              let file = try? JSONDecoder().decode(RuleFile.self, from: data) else {
   133	            return RuleSet(rules: [], homeRelative: homeRelative)
   134	        }
   135	        return RuleSet(rules: file.rules, homeRelative: homeRelative)
   136	    }
   137	
   138	    static func decode(_ data: Data, homeRelative: String) throws -> RuleSet {
   139	        RuleSet(rules: try JSONDecoder().decode(RuleFile.self, from: data).rules, homeRelative: homeRelative)
   140	    }
   141	
   142	    func classify(_ tree: FlatTree, rootCategory: StorageCategory = .systemData) -> Classification {
   143	        let n = tree.count
   144	        var categoryOf = [UInt8](repeating: rootCategory.index, count: n)
   145	        var ruleOf = [Int32](repeating: -1, count: n)
   146	        var states: [Int: [Int]] = [0: [0]]
   147	        guard n > 1 else { return Classification(categoryOf: categoryOf, ruleOf: ruleOf) }
   148	        for i in 1..<n {
   149	            let p = Int(tree.parent[i])
   150	            categoryOf[i] = categoryOf[p]
   151	            guard let parentStates = states[p] else { continue }
   152	            let name = tree.names[i]
   153	            var next: [Int] = []
   154	            for s in parentStates {
   155	                if let t = trie[s].literal[name] { next.append(t) }
   156	                for (pattern, t) in trie[s].globs where fnmatch(pattern, name, 0) == 0 { next.append(t) }
   157	            }
   158	            guard !next.isEmpty else { continue }
   159	            states[i] = next
   160	            if let best = next.compactMap({ trie[$0].rule }).max() {
   161	                ruleOf[i] = Int32(best)
   162	                if let c = rules[best].category { categoryOf[i] = c.index }
   163	            }
   164	        }
   165	        return Classification(categoryOf: categoryOf, ruleOf: ruleOf)
   166	    }
   167	
   168	    /// Rule that applies to a node: the node's own rule, else the nearest ancestor's.
   169	    func nearestRule(for i: Int, in tree: FlatTree, classification: Classification) -> (rule: Rule, exact: Bool)? {
   170	        var cur = i
   171	        while cur >= 0 {
   172	            let r = classification.ruleOf[cur]
   173	            if r >= 0 { return (rules[Int(r)], cur == i) }
   174	            cur = Int(tree.parent[cur])
   175	        }
   176	        return nil
   177	    }
   178	}
   179	
   180	/// Category totals and per-category subtree sizes for one Data-volume tree.
   181	final class CategoryIndex {
   182	    let tree: FlatTree
   183	    let classification: Classification
   184	    let rules: RuleSet
   185	    private(set) var totals: [StorageCategory: UInt64] = [:]
   186	    private var filtered: [UInt8: [UInt64]] = [:]
   187	    private let lock = NSLock()
   188	
   189	    init(tree: FlatTree, rules: RuleSet) {
   190	        self.tree = tree
   191	        self.rules = rules
   192	        self.classification = rules.classify(tree)
   193	        var t = [UInt64](repeating: 0, count: StorageCategory.allCases.count)
   194	        for i in 0..<tree.count {
   195	            t[Int(classification.categoryOf[i])] &+= tree.ownSize[i]
   196	        }
   197	        for c in StorageCategory.allCases { totals[c] = t[Int(c.index)] }
   198	    }
   199	
   200	    /// Subtree sizes counting only bytes assigned to `category`.
   201	    func sizes(for category: StorageCategory) -> [UInt64] {
   202	        lock.lock(); defer { lock.unlock() }
   203	        if let cached = filtered[category.index] { return cached }
   204	        let n = tree.count
   205	        var s = [UInt64](repeating: 0, count: n)
   206	        let c = category.index
   207	        for i in 0..<n where classification.categoryOf[i] == c { s[i] = tree.ownSize[i] }
   208	        if n > 1 {
   209	            for i in stride(from: n - 1, through: 1, by: -1) {
   210	                s[Int(tree.parent[i])] &+= s[i]
   211	            }
   212	        }
   213	        filtered[category.index] = s
   214	        return s
   215	    }
   216	}
