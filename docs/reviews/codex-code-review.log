   125	    // MARK: - Derived numbers
   126	
   127	    /// Volume consumed minus what the scan found. Negative when clones are counted twice.
   128	    var dataUnexplained: Int64? {
   129	        guard let v = volumes?.data, let t = data?.tree else { return nil }
   130	        return Int64(v.consumed) - Int64(t.total[0])
   131	    }
   132	
   133	    /// The app's estimate of the macOS bar: system, Preboot and Recovery volumes plus /System on Data.
   134	    var macOSEstimate: UInt64 {
   135	        let v = volumes
   136	        return (v?.system?.consumed ?? 0) + (v?.preboot?.consumed ?? 0) + (v?.recovery?.consumed ?? 0)
   137	            + (index?.totals[.macOS] ?? 0)
   138	    }
   139	
   140	    /// System Data: Data-volume bytes the rules leave in System Data, plus swap, plus any
   141	    /// positive unexplained remainder.
   142	    var systemDataEstimate: UInt64 {
   143	        let base = index?.totals[.systemData] ?? 0
   144	        let vm = volumes?.vm?.consumed ?? 0
   145	        let extra = max(dataUnexplained ?? 0, 0)
   146	        return base + vm + UInt64(extra)
   147	    }
   148	
   149	    func total(for category: StorageCategory) -> UInt64 {
   150	        switch category {
   151	        case .macOS: return macOSEstimate
   152	        case .systemData: return systemDataEstimate
   153	        default: return index?.totals[category] ?? 0
   154	        }
   155	    }
   156	
   157	    /// Removes a node's bytes from the in-memory model after it was moved to the Trash,
   158	    /// by rescanning lazily. Simplest correct approach: mark data stale.
   159	    var dataIsStale = false
   160	}
