   111	    static func darwinUserCacheDir() -> String {
   112	        var buf = [CChar](repeating: 0, count: Int(PATH_MAX))
   113	        let n = confstr(_CS_DARWIN_USER_CACHE_DIR, &buf, buf.count)
   114	        guard n > 0 else { return "" }
   115	        // confstr returns a /var/... path; /var is a symlink, which SafeDeleter refuses.
   116	        guard let real = realpath(buf, nil) else { return "" }
   117	        defer { free(real) }
   118	        return String(cString: real)
