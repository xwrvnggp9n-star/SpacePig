   239	    /// Parses "This operation would free approximately 1.2GB of disk space."
   240	    static func parseBrewEstimate(_ text: String) -> UInt64? {
   241	        guard let r = text.range(of: #"approximately ([0-9.]+)([KMGT]?B)"#, options: .regularExpression) else { return nil }
   242	        let match = String(text[r]).replacingOccurrences(of: "approximately ", with: "")
   243	        let units: [String: Double] = ["B": 1, "KB": 1e3, "MB": 1e6, "GB": 1e9, "TB": 1e12]
   244	        let num = Double(match.prefix { "0123456789.".contains($0) }) ?? 0
   245	        let unit = String(match.drop { "0123456789.".contains($0) })
   246	        return UInt64(num * (units[unit] ?? 1))
   247	    }
