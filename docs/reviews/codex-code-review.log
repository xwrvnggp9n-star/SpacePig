   141	    /// Calls the helper and resumes exactly once, whether the reply or the error handler fires.
   142	    private func call<T>(_ body: @escaping (HelperProtocol, @escaping (Result<T, Error>) -> Void) -> Void) async throws -> T {
   143	        let c = proxyConnection()
   144	        return try await withCheckedThrowingContinuation { continuation in
   145	            let once = OnceFlag()
   146	            let finish: (Result<T, Error>) -> Void = { result in
   147	                if once.claim() { continuation.resume(with: result) }
   148	            }
   149	            guard let proxy = c.remoteObjectProxyWithErrorHandler({ error in
   150	                finish(.failure(HelperError.connection(error.localizedDescription)))
   151	            }) as? HelperProtocol else {
   152	                finish(.failure(HelperError.badReply))
   153	                return
   154	            }
   155	            body(proxy, finish)
   156	        }
   157	    }
