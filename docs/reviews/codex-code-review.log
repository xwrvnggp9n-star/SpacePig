   237	/// Holds an AuthorizationRef with the admin right for as long as the helper needs it.
   238	final class AdminAuthorization: @unchecked Sendable {
   239	    private var ref: AuthorizationRef?
   240	    let externalForm: Data
   241	
   242	    struct Denied: LocalizedError { var errorDescription: String? { "Administrator authorization was cancelled." } }
   243	
   244	    init() throws {
   245	        var ref: AuthorizationRef?
   246	        guard AuthorizationCreate(nil, nil, [], &ref) == errAuthorizationSuccess, let ref else { throw Denied() }
   247	        let status: OSStatus = HelperConstants.cleanupRight.withCString { name in
   248	            var item = AuthorizationItem(name: name, valueLength: 0, value: nil, flags: 0)
   249	            return withUnsafeMutablePointer(to: &item) { itemPtr in
   250	                var rights = AuthorizationRights(count: 1, items: itemPtr)
   251	                return AuthorizationCopyRights(ref, &rights, nil, [.interactionAllowed, .extendRights, .preAuthorize], nil)
   252	            }
   253	        }
   254	        guard status == errAuthorizationSuccess else {
   255	            AuthorizationFree(ref, [])
   256	            throw Denied()
   257	        }
   258	        var ext = AuthorizationExternalForm()
   259	        guard AuthorizationMakeExternalForm(ref, &ext) == errAuthorizationSuccess else {
   260	            AuthorizationFree(ref, [])
   261	            throw Denied()
   262	        }
   263	        self.ref = ref
   264	        self.externalForm = withUnsafeBytes(of: &ext) { Data($0) }
   265	    }
   266	
   267	    deinit {
   268	        if let ref { AuthorizationFree(ref, [.destroyRights]) }
   269	    }
   270	}
